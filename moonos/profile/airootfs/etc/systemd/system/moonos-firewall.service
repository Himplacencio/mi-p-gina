[Unit]
Description=MoonOS: activar el firewall (ufw) la primera vez
ConditionPathExists=!/var/lib/moonos/firewall-listo
After=sysinit.target local-fs.target ufw.service
# Corre en paralelo para no retrasar el arranque (~5 s); el firewall queda activo segundos después
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/moonos-firewall

[Install]
WantedBy=multi-user.target
