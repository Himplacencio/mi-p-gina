#!/usr/bin/env python3
"""Bienvenida a MoonOS.

- Modo Live: botón para instalar, equipo detectado y ayuda.
- Sistema instalado: «Hazlo tuyo» para personalizar casi todo (tema, color,
  fondo animado, panel, efectos), juegos y comunidad.

Se abre sola al iniciar sesión (/etc/xdg/autostart/moonos-bienvenida.desktop).
Con MOONOS_DRY=1 solo imprime los comandos (para pruebas).
"""
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

from PyQt6.QtCore import Qt, QTimer, QProcess, QUrl
from PyQt6.QtGui import QDesktopServices, QFont, QIcon, QPixmap, QColor
from PyQt6.QtWidgets import (QApplication, QButtonGroup, QCheckBox, QFileDialog, QFrame, QGridLayout, QHBoxLayout,
                             QLabel, QMainWindow, QPushButton, QScrollArea, QStackedWidget, QVBoxLayout, QWidget)

VERSION = "Beta"
WEB = "https://himplacencio.github.io/mi-p-gina/moonos/"
FALLAS = "https://github.com/Himplacencio/mi-p-gina/issues?q=label%3Afalla"
REPORTAR = "https://github.com/Himplacencio/mi-p-gina/issues/new?template=falla.yml"
LOGO = "/usr/share/pixmaps/moonos.png"
FONDO_ESTATICO = "/usr/share/wallpapers/MoonOS/contents/images/1920x1080.png"
FONDO_ANIMADO = "org.moonos.lunaanimada"
DRY = os.environ.get("MOONOS_DRY") == "1"
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "moonos"


def is_live():
    if os.environ.get("MOONOS_LIVE") in ("0", "1"):  # solo para pruebas
        return os.environ["MOONOS_LIVE"] == "1"
    try:
        return "archisobasedir=" in Path("/proc/cmdline").read_text()
    except OSError:
        return False


def run(*cmd, detached=True):
    """Ejecuta un comando (sin esperar). En modo prueba solo lo muestra."""
    print("[moonos-bienvenida]", " ".join(shlex.quote(c) for c in cmd), flush=True)
    if DRY:
        return True
    try:
        if detached:
            return QProcess.startDetached(cmd[0], list(cmd[1:]))[0]
        return subprocess.run(cmd, check=False, timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def plasma_script(js):
    """Ejecuta un script de Plasma (panel, fondo) por D-Bus."""
    print("[moonos-bienvenida] plasma:", js.replace("\n", " "), flush=True)
    if DRY:
        return
    try:
        from PyQt6.QtDBus import QDBusConnection, QDBusInterface
        iface = QDBusInterface("org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", QDBusConnection.sessionBus())
        iface.call("evaluateScript", js)
    except Exception as e:  # noqa: BLE001 - nunca romper la app por esto
        print("plasma_script falló:", e)


def kwin_reconfigure():
    if DRY:
        return
    try:
        from PyQt6.QtDBus import QDBusConnection, QDBusInterface
        QDBusInterface("org.kde.KWin", "/KWin", "org.kde.KWin", QDBusConnection.sessionBus()).call("reconfigure")
    except Exception:  # noqa: BLE001
        pass


def hardware():
    gpu = "No detectada"
    try:
        out = subprocess.run(["lspci"], capture_output=True, text=True, timeout=5).stdout
        gpus = [l.split(": ", 1)[1] for l in out.splitlines() if re.search(r"VGA|3D|Display", l)]
        if gpus:
            gpu = re.sub(r"\s*\(rev .*\)$", "", gpus[-1])
    except (OSError, subprocess.SubprocessError, IndexError):
        pass
    ram = "?"
    try:
        kb = int(re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text()).group(1))
        ram = f"{kb / 1048576:.1f} GB".replace(".", ",")
    except (OSError, AttributeError):
        pass
    cpu = "?"
    try:
        cpu = re.search(r"model name\s*:\s*(.+)", Path("/proc/cpuinfo").read_text()).group(1).strip()
    except (OSError, AttributeError):
        pass
    return gpu, ram, cpu


STYLE = """
