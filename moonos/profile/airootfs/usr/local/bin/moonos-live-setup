#!/bin/bash
# Prepara la sesión Live: usuario "liveuser" sin contraseña, inicio
# de sesión automático en Plasma y acceso directo al instalador.
set -u

if ! id liveuser &>/dev/null; then
    useradd -m -G wheel,audio,video,storage,optical,input,gamemode -s /bin/bash -c "MoonOS Live" liveuser
fi
passwd -d liveuser >/dev/null

# Pantalla de carga de MoonOS también para el usuario Live (por si su carpeta ya existía)
install -dm755 -o liveuser -g liveuser /home/liveuser/.config
install -m644 -o liveuser -g liveuser /etc/xdg/ksplashrc /home/liveuser/.config/ksplashrc

install -dm750 /etc/sudoers.d
echo 'liveuser ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/90-liveuser
chmod 440 /etc/sudoers.d/90-liveuser

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/90-live-autologin.conf <<'CONF'
[Autologin]
User=liveuser
Session=plasma
Relogin=false
CONF

# Modo juego adaptado a la tarjeta gráfica de este equipo
/usr/local/bin/moonos-gamemode-config || true

# Configuración del instalador (solo existe en el modo Live)
mkdir -p /etc/calamares
cp -a /usr/share/moonos/calamares/. /etc/calamares/

# Acceso directo "Instalar MoonOS" en el escritorio
# setpriv cambia de usuario sin abrir una sesión de inicio (con runuser, logind
# hace esperar 2 minutos porque aún no se permiten sesiones en este punto del arranque)
as_live() { setpriv --reuid=liveuser --regid=liveuser --init-groups env HOME=/home/liveuser USER=liveuser LANG="${LANG:-es_MX.UTF-8}" "$@"; }
as_live xdg-user-dirs-update || true
desktop="$(as_live xdg-user-dir DESKTOP 2>/dev/null || echo /home/liveuser/Desktop)"
install -Dm755 -o liveuser -g liveuser /usr/share/applications/moonos-installer.desktop "$desktop/moonos-installer.desktop"
