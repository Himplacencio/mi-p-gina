        f, c = tarjeta("Micrófono", "Toca «Probar» y di algo como «abre Steam». La barra se mueve si Luna te oye.")
        self.barra = QProgressBar(); self.barra.setRange(0, 100); self.barra.setTextVisible(False)
        self.oido = QLabel("" if puede_escuchar() else "Este equipo no tiene el reconocimiento de voz o el micrófono "
                                                         "listo; puedes escribirle a Luna.")
        self.oido.setObjectName("muted"); self.oido.setWordWrap(True)
        pb = QPushButton("🎙  Probar"); pb.clicked.connect(self._probar_mic); pb.setEnabled(puede_escuchar())
        fila = QHBoxLayout(); fila.addWidget(pb); fila.addWidget(self.barra, 1); c.addLayout(fila); c.addWidget(self.oido)
        v.addWidget(f)

        f, c = tarjeta("Atajo de teclado", f"Ahora es {ATAJO}. Puedes cambiarlo en Configuración → Atajos → Luna.")
        cb = QPushButton("⌨  Cambiar el atajo")
        cb.clicked.connect(lambda: subprocess.Popen(["systemsettings", "kcm_keys"], start_new_session=True))
        fila = QHBoxLayout(); fila.addWidget(cb); fila.addStretch(1); c.addLayout(fila); v.addWidget(f)

        f, c = tarjeta("Lo que sé hacer", "Dilo con tus palabras: Luna entiende varias formas de pedir lo mismo. "
                                          "Los comandos de la terminal se muestran antes de ejecutarse, y los que "
                                          "cambian el sistema piden tu contraseña.")
        g = QGridLayout(); g.setHorizontalSpacing(20); g.setVerticalSpacing(4)
        for i, (grupo, frases) in enumerate(AYUDA.items()):
            tl = QLabel(grupo); tl.setObjectName("estado"); g.addWidget(tl, (i // 2) * 2, i % 2)
            fl = QLabel("\n".join("• " + x for x in frases)); fl.setObjectName("muted"); g.addWidget(fl, (i // 2) * 2 + 1, i % 2)
        c.addLayout(g); v.addWidget(f)
        v.addStretch(1)

    def _cambia(self, k, val):
        self.conf[k] = val; guardar_conf(self.conf)

    def _probar_mic(self):
        self.oido.setText("Habla ahora…")
        self.hilo = QThread(self); self.oreja = Oreja(5); self.oreja.moveToThread(self.hilo)
        self.hilo.started.connect(self.oreja.correr)
        self.oreja.nivel.connect(lambda n: self.barra.setValue(int(n * 100)))
        self.oreja.parcial.connect(lambda t: self.oido.setText(f"«{t}»"))
        self.oreja.listo.connect(lambda t: self.oido.setText(f"Luna entendió: «{t}»" if t else "No te escuché. ¿El micrófono está conectado?"))
        self.oreja.error.connect(self.oido.setText)
        self.oreja.listo.connect(self.hilo.quit); self.oreja.error.connect(self.hilo.quit)
        self.hilo.start()


class Presentacion(QWidget):
    """Se abre una vez después de instalar MoonOS: Luna se presenta y se configura en 3 pasos."""
    def __init__(self):
        super().__init__()
        self.conf = leer_conf()
        self.setWindowTitle("Conoce a Luna"); self.resize(640, 560); self.setObjectName("fondo")
        if Path(ICONO).exists():
            self.setWindowIcon(QIcon(ICONO))
        v = QVBoxLayout(self); v.setContentsMargins(34, 30, 34, 28); v.setSpacing(14)
        self.orbe = Orbe(150); v.addWidget(self.orbe, 0, Qt.AlignmentFlag.AlignHCenter)
        self.pasos = QStackedWidget(); v.addWidget(self.pasos, 1)

        def paso(titulo, texto, extra=None, botones=()):
            w = QWidget(); l = QVBoxLayout(w); l.setSpacing(12)
            t = QLabel(titulo); t.setObjectName("h1"); t.setAlignment(Qt.AlignmentFlag.AlignHCenter); l.addWidget(t)
            d = QLabel(texto); d.setObjectName("muted"); d.setWordWrap(True); d.setAlignment(Qt.AlignmentFlag.AlignHCenter)
            d.setStyleSheet("font-size: 15px;"); l.addWidget(d)
            if extra:
                l.addWidget(extra)
            l.addStretch(1)
            fila = QHBoxLayout(); fila.addStretch(1)
            for txt, principal, fn in botones:
                b = QPushButton(txt); b.clicked.connect(fn)
                if principal:
                    b.setObjectName("principal")
                fila.addWidget(b)
            fila.addStretch(1); l.addLayout(fila)
            self.pasos.addWidget(w)

        paso("¡Hola! Soy Luna 🌙",
             "Soy la asistente de voz de MoonOS. Puedo abrir tus apps y juegos, controlar la música y el volumen, "
             "decirte cuánta RAM usas y hasta ejecutar comandos de la terminal por ti.\n\n"
             "Funciono sin internet: lo que me dices no sale de tu PC.",
             botones=(("Ahora no", False, self._no), ("¡Actívala!", True, self._si)))
        paso("Elige mi voz", "Puedes cambiarla cuando quieras en mis ajustes.",
             extra=PanelVoz(self.conf, lambda: guardar_conf(self.conf)),
             botones=(("Siguiente →", True, lambda: self.pasos.setCurrentIndex(2)),))
        paso("¡Lista!", f"Pulsa {ATAJO} o toca mi ícono en el dock y dime, por ejemplo:\n"
                         "«abre Steam» · «sube el volumen» · «¿cuánta RAM estoy usando?»",
             botones=(("Probar ahora", True, self._probar), ("Cerrar", False, self.close)))

    def _si(self):
        self.conf.update(activa=True, configurada=True); guardar_conf(self.conf)
        hablar("¡Gracias! Ahora elige mi voz.", self.conf)
        self.pasos.setCurrentIndex(1)

    def _no(self):
        self.conf.update(activa=False, configurada=True); guardar_conf(self.conf)
        self.close()

    def _probar(self):
        subprocess.Popen([sys.argv[0]], start_new_session=True); self.close()


def main():
    args = sys.argv[1:]
    if "--primera-vez" in args:
        c = leer_conf()
        if c.get("configurada") or es_live():
            return 0
    app = QApplication(sys.argv)
    app.setApplicationName("Luna"); app.setDesktopFileName("moonos-luna")
    app.setStyleSheet(ESTILO)
    if Path(ICONO).exists():
        app.setWindowIcon(QIcon(ICONO))
    if "--ajustes" in args:
        w = Ajustes()
    elif "--primera-vez" in args:
        w = Presentacion()
    else:
        w = Burbuja(escuchar="--escribir" not in args)
    w.show()
    if os.environ.get("MOONOS_SHOT_TEXTO") and isinstance(w, Burbuja):  # pruebas: simula una orden
        QTimer.singleShot(100, lambda: w.procesar(os.environ["MOONOS_SHOT_TEXTO"]))
    foto = os.environ.get("MOONOS_SHOT")
    if foto:  # pruebas: captura y salir
        QTimer.singleShot(int(os.environ.get("MOONOS_SHOT_MS", "900")), lambda: (w.grab().save(foto), app.quit()))
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
