#!/usr/bin/env python3
"""Luna, la asistente de voz de MoonOS.

Funciona sin internet: escucha con Vosk (libvosk.so + modelo en español), entiende
órdenes en español y responde con voz usando Piper (o espeak-ng si no hay Piper).
Nada de lo que dices sale de tu PC.

Uso:
  moonos-luna                     abre la burbuja de Luna y escucha (atajo: Super + J)
  moonos-luna --escribir          abre la burbuja sin escuchar (para escribir)
  moonos-luna --ajustes           ventana para configurar a Luna
  moonos-luna --primera-vez       presentación y configuración (tras instalar MoonOS)
  moonos-luna --probar "texto"    muestra qué entendería Luna (no hace nada; para pruebas)
  moonos-luna --decir-archivo A "texto"   guarda en A.wav lo que diría Luna
  moonos-luna --escuchar-archivo A        reconoce lo que se dice en el .wav A
"""
import ctypes
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import unicodedata
import wave
from pathlib import Path

LIB = Path("/usr/lib/moonos-luna")
DAT = Path("/usr/share/moonos/luna")
MODELO = DAT / "vosk-es"
PIPER = LIB / "piper" / "piper"
VOCES_DIR = DAT / "voces"
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "moonos" / "luna.json"
VOCES = {  # clave: (archivo, nombre, descripción)
    "daniela": ("es_AR-daniela-high", "Daniela", "voz femenina"),
    "ald": ("es_MX-ald-medium", "Ald", "voz masculina"),
}
ATAJO = "Super + J"
POR_DEFECTO = {"activa": True, "voz": "daniela", "velocidad": 1.0, "configurada": False}


# ======================================================================
#  Configuración
# ======================================================================
def leer_conf():
    c = dict(POR_DEFECTO)
    try:
        c.update(json.loads(CONF.read_text()))
    except (OSError, ValueError):
        pass
    return c


def guardar_conf(c):
    try:
        CONF.parent.mkdir(parents=True, exist_ok=True)
        CONF.write_text(json.dumps(c, indent=2, ensure_ascii=False))
    except OSError:
        pass


def es_live():
    try:
        return "archisobasedir" in Path("/proc/cmdline").read_text()
    except OSError:
        return False


def voces_disponibles():
    return [k for k, (f, _, _) in VOCES.items() if (VOCES_DIR / f"{f}.onnx").exists()]


# ======================================================================
#  Entender lo que se dice
# ======================================================================
def normalizar(t):
    t = t.lower().replace("ñ", "\0")
    t = "".join(ch for ch in unicodedata.normalize("NFD", t) if unicodedata.category(ch) != "Mn").replace("\0", "ñ")
    t = re.sub(r"[¿?¡!.,;:«»\"']", " ", t)
    t = re.sub(r"^\s*(oye|hey|ey|hola)?\s*luna\b", " ", t)  # «oye Luna, …»
    return re.sub(r"\s+", " ", t).strip()


NUMEROS = {"cero": 0, "uno": 1, "un": 1, "una": 1, "dos": 2, "tres": 3, "cuatro": 4, "cinco": 5, "seis": 6, "siete": 7,
           "ocho": 8, "nueve": 9, "diez": 10, "quince": 15, "veinte": 20, "veinticinco": 25, "treinta": 30,
           "cuarenta": 40, "cincuenta": 50, "sesenta": 60, "setenta": 70, "setenta y cinco": 75, "ochenta": 80,
           "noventa": 90, "cien": 100, "ciento": 100, "maximo": 100, "medio": 50, "la mitad": 50}


def numero(t):
    m = re.search(r"\b(\d{1,3})\b", t)
    if m:
        return int(m.group(1))
    for palabra in sorted(NUMEROS, key=len, reverse=True):
        if re.search(rf"\b{palabra}\b", t):
            return NUMEROS[palabra]
    return None


# (palabras que la nombran, nombre bonito, id del .desktop o comando, ¿se instala desde la Tienda?)
APPS = [
    (r"steam", "Steam", "steam.desktop", False),
    (r"spotify|musica de spotify", "Spotify", "com.spotify.Client.desktop", True),
    (r"discord", "Discord", "com.discordapp.Discord.desktop", True),
    (r"firefox|navegador|internet|google", "Firefox", "firefox.desktop", False),
    (r"terminal|consola|konsole", "la terminal", "org.kde.konsole.desktop", False),
    (r"archivos|carpetas|dolphin|explorador|mis documentos", "los archivos", "org.kde.dolphin.desktop", False),
    (r"tienda|tienda de apps|app store", "la Tienda", "moonos-tienda.desktop", False),
    (r"bienvenida", "la Bienvenida", "moonos-bienvenida.desktop", False),
    (r"configuracion|ajustes del sistema|preferencias", "la configuración", "systemsettings.desktop", False),
    (r"lutris", "Lutris", "net.lutris.Lutris.desktop", False),
    (r"videos|reproductor|haruna", "el reproductor de video", "org.kde.haruna.desktop", False),
    (r"notas|editor de texto|bloc de notas|kwrite", "el editor de texto", "org.kde.kwrite.desktop", False),
    (r"obs|grabar pantalla", "OBS Studio", "com.obsproject.Studio.desktop", True),
    (r"heroic|epic games", "Heroic", "com.heroicgameslauncher.hgl.desktop", True),
    (r"chrome", "Chrome", "com.google.Chrome.desktop", True),
    (r"brave", "Brave", "com.brave.Browser.desktop", True),
    (r"vlc", "VLC", "org.videolan.VLC.desktop", True),
]
DIRS_APPS = [Path.home() / ".local/share/flatpak/exports/share/applications", Path("/var/lib/flatpak/exports/share/applications"),
             Path("/usr/local/share/applications"), Path("/usr/share/applications"), Path.home() / ".local/share/applications"]


def buscar_desktop(did):
    for d in DIRS_APPS:
        if (d / did).exists():
            return d / did
    return None


def paquete(texto):
    """De «instala obs studio» saca «obs-studio» (solo letras, números y guiones)."""
    p = re.sub(r"\b(el|la|los|las|un|una|programa|paquete|app|aplicacion|por favor|porfa)\b", " ", texto)
    p = re.sub(r"[^a-z0-9+. -]", "", p).strip()
    return re.sub(r"\s+", "-", p)[:60]


DIAS = ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"]
MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre",
         "noviembre", "diciembre"]

AYUDA = {
    "Apps": ["abre Steam", "abre Spotify", "abre el navegador", "abre la terminal", "abre la Tienda"],
    "Música y volumen": ["sube el volumen", "volumen al 50", "silencio", "pausa la música", "siguiente canción",
                         "¿qué canción suena?"],
    "Tu PC": ["¿cuánta RAM estoy usando?", "¿cuánto espacio me queda?", "¿qué tarjeta gráfica tengo?",
              "¿está activo el modo juego?", "¿cuánta batería tengo?", "toma una captura", "bloquea la pantalla"],
    "Terminal": ["actualiza el sistema", "instala vlc", "busca discord", "limpia paquetes viejos",
                 "muestra mi sistema"],
    "Otros": ["¿qué hora es?", "¿qué día es hoy?", "apaga el computador", "reinicia el computador"],
}


def leer(archivo):
    try:
        return Path(archivo).read_text()
    except OSError:
        return ""


def ram():
    m = {k: int(v) for k, v in re.findall(r"^(\w+):\s+(\d+)", leer("/proc/meminfo"), re.M)}
    if "MemTotal" not in m:
        return "No pude leer la memoria."
    usada = (m["MemTotal"] - m.get("MemAvailable", 0)) / 1048576
    return f"Estás usando {usada:.1f} de {m['MemTotal'] / 1048576:.1f} gigas de RAM.".replace(".", ",", 2)


def disco():
    try:
        u = shutil.disk_usage(Path.home())
        return f"Te quedan {u.free / 1e9:.0f} gigas libres de {u.total / 1e9:.0f}."
    except OSError:
        return "No pude revisar el disco."


def grafica():
    try:
        out = subprocess.run(["lspci"], capture_output=True, text=True, timeout=5).stdout
        g = [l.split(": ", 1)[1] for l in out.splitlines() if re.search(r"VGA|3D|Display", l)]
        if g:
            return "Tu tarjeta gráfica es " + re.sub(r"\s*\(rev .*\)$", "", g[-1]) + "."
    except (OSError, subprocess.SubprocessError, IndexError):
        pass
    return "No pude detectar la tarjeta gráfica."


def bateria():
    for b in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        cap = leer(b / "capacity").strip()
        if cap:
            est = leer(b / "status").strip()
            extra = ", y se está cargando" if est == "Charging" else ""
            return f"Tienes {cap} por ciento de batería{extra}."
    return "Este equipo no tiene batería, está conectado a la corriente."


def modo_juego():
    try:
        out = subprocess.run(["gamemoded", "-s"], capture_output=True, text=True, timeout=5).stdout
        return "Sí, el modo juego está activo." if "is active" in out else \
            "Ahora no está activo. Se activa solo cuando abres un juego."
    except (OSError, subprocess.SubprocessError):
        return "No pude revisar el modo juego."


def cancion():
    try:
        out = subprocess.run(["playerctl", "metadata", "--format", "{{title}}|{{artist}}"], capture_output=True,
                             text=True, timeout=5).stdout.strip()
        if out and out != "|":
            t, a = (out.split("|") + [""])[:2]
            return f"Está sonando {t}" + (f", de {a}." if a else ".")
    except (OSError, subprocess.SubprocessError):
        pass
    return "No está sonando nada ahora."


def entender(dicho):
    """Devuelve un dict: respuesta (texto), y opcionalmente:
       run (lista: comando), term (comando para la terminal), abrir (archivo .desktop),
       confirmar (texto del botón), tienda (abrir la Tienda), ayuda (True)."""
    t = normalizar(dicho)
    r = lambda texto, **kw: dict(respuesta=texto, entendido=t, **kw)  # noqa: E731
    if not t:
        return r("No te escuché. Puedes volver a intentarlo o escribirme.")
    tiene = lambda pat: re.search(pat, t) is not None  # noqa: E731

    # --- conversación ---
    if tiene(r"^(hola|buenas|buenos dias|buenas tardes|buenas noches)\b") and len(t.split()) <= 3:
        return r("¡Hola! ¿En qué te ayudo?")
    if tiene(r"\bgracias\b"):
        return r("¡De nada! Para eso estoy.")
    if tiene(r"quien eres|como te llamas|que eres"):
        return r("Soy Luna, la asistente de MoonOS. Funciono sin internet y lo que me dices no sale de tu PC.")
    if tiene(r"\bayuda\b|que (puedes|sabes) hacer|que haces|comandos"):
        return r("Esto es lo que sé hacer. Prueba con cualquiera.", ayuda=True)

    # --- energía (siempre se pregunta antes) ---
    if tiene(r"\b(apaga|apagar|apagate)\b.*\b(pc|computador|computadora|equipo|ordenador|sistema|todo)\b|^apaga(r)?$"):
        return r("¿Seguro que quieres apagar el computador?", run=["systemctl", "poweroff"], confirmar="Sí, apagar")
    if tiene(r"\b(reinicia|reiniciar)\b"):
        return r("¿Seguro que quieres reiniciar el computador?", run=["systemctl", "reboot"], confirmar="Sí, reiniciar")
    if tiene(r"\bbloquea|bloquear\b"):
        return r("Listo, bloqueo la pantalla.", run=["loginctl", "lock-session"])

    # --- volumen ---
    if tiene(r"\bvolumen\b|\bsonido\b|\bsilencio|\bmutea|\bsilencia"):
        n = numero(t)
        if tiene(r"silencio|mutea|silencia|quita el sonido|sin sonido"):
            return r("Silencio.", run=["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
        if n is not None and tiene(r"\b(al|a|en|pon)\b"):
            n = max(0, min(n, 100))
            return r(f"Volumen al {n} por ciento.", run=["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{n / 100:.2f}"])
        if tiene(r"\bsube|subir|mas alto|aumenta|mas fuerte"):
            return r("Subo el volumen.", run=["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "10%+"])
        if tiene(r"\bbaja|bajar|mas bajo|disminuye|mas despacio"):
            return r("Bajo el volumen.", run=["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "10%-"])

    # --- música ---
    if tiene(r"que (cancion|tema|musica) (suena|esta sonando|es)|que esta sonando"):
        return r(cancion())
    if tiene(r"\bsiguiente\b|\bsalta\b|proxima cancion|otra cancion"):
        return r("Siguiente canción.", run=["playerctl", "next"])
    if tiene(r"\banterior\b|cancion de antes"):
        return r("Canción anterior.", run=["playerctl", "previous"])
    if tiene(r"\b(pausa|pausar|para|deten|detener)\b.*\b(musica|cancion|spotify|video)\b|^(pausa|pausar)$"):
        return r("Pausado.", run=["playerctl", "pause"])
    if tiene(r"\b(reproduce|reproducir|play|continua|sigue|reanuda|pon)\b.*\b(musica|cancion|spotify)\b|^play$"):
        return r("¡Dale play!", run=["playerctl", "play"])

    # --- terminal (Luna muestra el comando para que aprendas) ---
    if tiene(r"\b(actualiza|actualizar|actualizacion|actualizaciones)\b"):
        return r("Abro la terminal para actualizar el sistema. Te va a pedir tu contraseña.", term="sudo pacman -Syu")
    m = re.search(r"\b(desinstala|desinstalar|borra el programa|elimina el programa|quita el programa)\s+(.+)", t)
    if m and paquete(m.group(2)):
        p = paquete(m.group(2))
        return r(f"Abro la terminal para desinstalar {p}. Te va a pedir tu contraseña.", term=f"sudo pacman -Rns {p}")
    m = re.search(r"\b(instala|instalar|instalame|descarga|descargar)\s+(.+)", t)
    if m:
        nombre = m.group(2)
        for pat, bonito, _did, de_tienda in APPS:
            if de_tienda and re.search(rf"\b({pat})\b", nombre):
                return r(f"{bonito} se instala desde la Tienda MoonOS. Te la abro.", abrir="moonos-tienda.desktop")
        p = paquete(nombre)
        if p:
            return r(f"Abro la terminal para instalar {p}. Te va a pedir tu contraseña.", term=f"sudo pacman -S {p}")
    m = re.search(r"\b(busca|buscar|buscame)\s+(.+)", t)
    if m and paquete(m.group(2)):
        p = paquete(m.group(2))
        return r(f"Busco {p} en los programas de MoonOS.", term=f"pacman -Ss {p}")
    if tiene(r"limpia|limpiar|huerfanos|paquetes viejos|basura"):
        return r("Abro la terminal para limpiar paquetes que ya nadie usa.", term="sudo pacman -Rns $(pacman -Qdtq)")
    if tiene(r"fastfetch|muestra mi sistema|informacion del sistema|info del sistema|presumir"):
        return r("¡A presumir!", term="fastfetch")
    if tiene(r"errores|que fallo|que falla"):
        return r("Te muestro los errores del arranque.", term="journalctl -p err -b --no-pager | tail -40")
    if tiene(r"procesos|que usa la cpu|que esta usando|monitor"):
        return r("Abro el monitor de procesos. Sales con F10.", term="htop")

    # --- tu PC ---
    if tiene(r"\b(ram|memoria)\b"):
        return r(ram())
    if tiene(r"espacio|disco|almacenamiento"):
        return r(disco())
    if tiene(r"grafica|tarjeta de video|gpu"):
        return r(grafica())
    if tiene(r"bateria|carga"):
        return r(bateria())
    if tiene(r"modo juego|gamemode"):
        return r(modo_juego())
    if tiene(r"captura|pantallazo|screenshot"):
        return r("Listo, guardé la captura en tu carpeta Imágenes.", run=["spectacle", "-b", "-n", "-f"])

    # --- hora y fecha ---
    ahora = datetime.datetime.now()
    if tiene(r"que hora|la hora"):
        h, mi = ahora.hour, ahora.minute
        return r(f"Son las {h}:{mi:02d}." if h != 1 else f"Es la {h}:{mi:02d}.")
    if tiene(r"que dia|fecha|hoy es"):
        return r(f"Hoy es {DIAS[ahora.weekday()]} {ahora.day} de {MESES[ahora.month - 1]}.")

    # --- abrir apps ---
    abrir = tiene(r"\b(abre|abrir|abreme|inicia|iniciar|ejecuta|lanza|entra a|quiero (usar|jugar|ver|abrir)|pon|muestra)\b")
    for pat, bonito, did, de_tienda in APPS:
        if re.search(rf"\b({pat})\b", t) and (abrir or len(t.split()) <= 2):
            if buscar_desktop(did) or did.startswith("moonos-"):
                return r(f"Abro {bonito}.", abrir=did)
            if de_tienda:
                return r(f"{bonito} todavía no está instalado. Te abro la Tienda para instalarlo.",
                         abrir="moonos-tienda.desktop")
            return r(f"No encontré {bonito} en este equipo.")

    return r("No entendí eso. Di «ayuda» para ver lo que sé hacer.")


# ======================================================================
#  Hacer lo que se pidió
# ======================================================================
def ejecutar(accion):
    if accion.get("run"):
        subprocess.Popen(accion["run"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if accion.get("abrir"):
        d = buscar_desktop(accion["abrir"])
        cmd = ["gio", "launch", str(d)] if d else [accion["abrir"].removesuffix(".desktop")]
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if accion.get("term"):
        c = accion["term"]
        guion = (f"printf '\\033[1;38;2;169;150;255m🌙 Luna ejecuta:\\033[0m %s\\n\\n' {shlex.quote(c)}; {c}; "
                 "echo; read -rp 'Listo. Pulsa Enter para cerrar esta ventana… '")
        subprocess.Popen(["konsole", "-e", "bash", "-c", guion], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


# ======================================================================
#  Voz (texto a voz)
# ======================================================================
def para_decir(texto):
    """Ajustes para que la voz lo lea bien."""
    t = texto.replace("MoonOS", "Mun O Ese").replace("RAM", "ram").replace("Super + J", "Super más jota")
    return re.sub(r"(\d+):(\d\d)", lambda m: f"{m.group(1)} y {int(m.group(2))}" if m.group(2) != "00" else m.group(1), t)


def comando_voz(texto, conf, archivo=None):
    """Devuelve (lista de comandos encadenados) para decir el texto, o None si no hay voz."""
    if conf.get("voz") == "ninguna":
        return None
    texto = para_decir(texto)
    clave = conf.get("voz") if conf.get("voz") in VOCES else "daniela"
    f = VOCES_DIR / f"{VOCES[clave][0]}.onnx"
    if PIPER.exists() and not f.exists() and voces_disponibles():
        f = VOCES_DIR / f"{VOCES[voces_disponibles()[0]][0]}.onnx"
    vel = max(0.6, min(float(conf.get("velocidad", 1.0)), 1.6))
    if PIPER.exists() and f.exists():
        piper = [str(PIPER), "--model", str(f), "--length_scale", f"{1 / vel:.2f}", "--quiet"]
        if archivo:
            return [piper + ["--output_file", archivo]], texto
        try:
            rate = json.loads(Path(str(f) + ".json").read_text())["audio"]["sample_rate"]
        except (OSError, ValueError, KeyError):
            rate = 22050
        return [piper + ["--output_raw"], ["pw-play", "--rate", str(rate), "--channels", "1", "--format", "s16", "-"]], texto
    if shutil.which("espeak-ng"):
        esp = ["espeak-ng", "-v", "es-419", "-s", str(int(165 * vel))]
        return [esp + (["-w", archivo] if archivo else [])], texto
    return None


def hablar(texto, conf, archivo=None, esperar=False):
    cv = comando_voz(texto, conf, archivo)
    if not cv:
        return None
    cmds, texto = cv
    try:
        p1 = subprocess.Popen(cmds[0], stdin=subprocess.PIPE, stdout=subprocess.PIPE if len(cmds) > 1 else subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL)
        last = p1
        if len(cmds) > 1:
            last = subprocess.Popen(cmds[1], stdin=p1.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p1.stdout.close()
        p1.stdin.write(texto.encode()); p1.stdin.close()
        if esperar:
            last.wait(timeout=60)
        return last
    except (OSError, subprocess.SubprocessError):
        return None


# ======================================================================
#  Oído (voz a texto) con libvosk.so
# ======================================================================
class Oido:
    def __init__(self, rate=16000):
        lib = ctypes.CDLL(str(LIB / "libvosk.so"))
        lib.vosk_set_log_level(-1)
        lib.vosk_model_new.restype = ctypes.c_void_p
        lib.vosk_model_new.argtypes = [ctypes.c_char_p]
        lib.vosk_recognizer_new.restype = ctypes.c_void_p
        lib.vosk_recognizer_new.argtypes = [ctypes.c_void_p, ctypes.c_float]
        lib.vosk_recognizer_accept_waveform.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
        for fn in ("vosk_recognizer_result", "vosk_recognizer_partial_result", "vosk_recognizer_final_result"):
            getattr(lib, fn).restype = ctypes.c_char_p
            getattr(lib, fn).argtypes = [ctypes.c_void_p]
        lib.vosk_recognizer_free.argtypes = [ctypes.c_void_p]
        self.lib = lib
        self.modelo = lib.vosk_model_new(str(MODELO).encode())
        if not self.modelo:
            raise OSError("no se pudo cargar el modelo de voz")
        self.rec = lib.vosk_recognizer_new(self.modelo, float(rate))

    def oir(self, datos):
        """Le pasa audio (16 bits mono). Devuelve (terminó_frase, texto)."""
        fin = self.lib.vosk_recognizer_accept_waveform(self.rec, datos, len(datos))
        if fin:
            return True, json.loads(self.lib.vosk_recognizer_result(self.rec) or b"{}").get("text", "")
        return False, json.loads(self.lib.vosk_recognizer_partial_result(self.rec) or b"{}").get("partial", "")

    def final(self):
        return json.loads(self.lib.vosk_recognizer_final_result(self.rec) or b"{}").get("text", "")


def puede_escuchar():
    return (LIB / "libvosk.so").exists() and MODELO.is_dir() and shutil.which("pw-record") is not None


def escuchar_archivo(ruta):
    with wave.open(ruta, "rb") as w:
        o = Oido(w.getframerate())
        texto = ""
        while True:
            d = w.readframes(4000)
            if not d:
                break
            fin, t = o.oir(d)
            if fin and t:
                texto += " " + t
        return (texto + " " + o.final()).strip()


# ======================================================================
#  Línea de comandos (pruebas, sin ventanas)
# ======================================================================
if len(sys.argv) > 2 and sys.argv[1] == "--probar":
    a = entender(" ".join(sys.argv[2:]))
    print(json.dumps({k: v for k, v in a.items()}, ensure_ascii=False))
    sys.exit(0)
if len(sys.argv) > 3 and sys.argv[1] == "--decir-archivo":
    _c = leer_conf()
    if _c.get("voz") == "ninguna":
        _c["voz"] = "daniela"
    p = hablar(" ".join(sys.argv[3:]), _c, archivo=sys.argv[2], esperar=True)
    ok = p is not None and Path(sys.argv[2]).exists() and Path(sys.argv[2]).stat().st_size > 1000
    print(("voz guardada en " + sys.argv[2]) if ok else "no se pudo generar la voz")
    sys.exit(0 if ok else 1)
if len(sys.argv) > 2 and sys.argv[1] == "--escuchar-archivo":
    try:
        print("Luna escuchó:", escuchar_archivo(sys.argv[2]))
    except (OSError, wave.Error) as e:
        print("no se pudo escuchar:", e); sys.exit(1)
    sys.exit(0)


