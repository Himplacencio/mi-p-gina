class Orbe(QWidget):
    """La luna de Luna: brilla, late con tu voz y gira cuando piensa."""
    def __init__(self, tam=150):
        super().__init__()
        self.setFixedSize(tam, tam)
        self.estado = "quieta"  # quieta, escuchando, pensando, hablando, error
        self.nivel = 0.0
        self.t = 0.0
        tm = QTimer(self); tm.timeout.connect(self._paso); tm.start(33)

    def _paso(self):
        self.t += 0.033
        self.nivel *= 0.86
        self.update()

    def paintEvent(self, _):
        p = QPainter(self); p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w = self.width(); c = QPointF(w / 2, w / 2); R = w * 0.27
        col = {"error": QColor("#ff9db5"), "hablando": QColor("#8fb2ff")}.get(self.estado, QColor("#a996ff"))
        # halo
        late = 1 + (0.06 * math.sin(self.t * 2.4) if self.estado == "quieta" else 0.0) + min(self.nivel, 1) * 0.35
        if self.estado == "hablando":
            late += 0.08 * abs(math.sin(self.t * 7))
        rh = min(w / 2 - 1, R * 1.75 * late)  # el halo nunca toca el borde (si no, se ve cuadrado)
        g = QRadialGradient(c, rh)
        h = QColor(col); h.setAlpha(110); g.setColorAt(0, h); h.setAlpha(40); g.setColorAt(0.6, h)
        h.setAlpha(0); g.setColorAt(1, h)
        p.setPen(Qt.PenStyle.NoPen); p.setBrush(g); p.drawEllipse(c, rh, rh)
        # anillos que salen cuando escucha
        if self.estado in ("escuchando", "hablando"):
            for k in range(3):
                f = ((self.t * 0.7 + k / 3) % 1)
                a = QColor(col); a.setAlphaF(max(0.0, 0.45 * (1 - f)))
                p.setPen(QPen(a, 2)); p.setBrush(Qt.BrushStyle.NoBrush)
                rr = R * (1.15 + f * 0.85 + self.nivel * 0.2)
                p.drawEllipse(c, rr, rr)
        # arco que gira cuando piensa
        if self.estado == "pensando":
            pen = QPen(col, 4); pen.setCapStyle(Qt.PenCapStyle.RoundCap); p.setPen(pen)
            rr = R * 1.32
            p.drawArc(QRectF(c.x() - rr, c.y() - rr, 2 * rr, 2 * rr), int(-self.t * 300 * 16), 100 * 16)
        # la media luna
        luna = QPainterPath(); luna.addEllipse(c, R, R)
        corte = QPainterPath(); corte.addEllipse(QPointF(c.x() + R * 0.45, c.y() - R * 0.32), R * 0.86, R * 0.86)
        p.setPen(Qt.PenStyle.NoPen)
        fondo = QColor(col); fondo.setAlpha(45); p.setBrush(fondo); p.drawEllipse(c, R, R)
        p.setBrush(QColor("#f1edff")); p.drawPath(luna.subtracted(corte))


class Oreja(QObject):
    """Graba del micrófono con pw-record y se lo pasa a Vosk (en otro hilo)."""
    nivel = pyqtSignal(float)
    parcial = pyqtSignal(str)
    listo = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, segundos=8):
        super().__init__()
        self.segundos = segundos
        self.parar = False

    def correr(self):
        try:
            o = Oido(16000)
        except OSError as e:
            self.error.emit(str(e)); return
        try:
            proc = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", "-"],
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            self.error.emit("No encontré el micrófono."); return
        leidos, habla, silencio, ultimo = 0, False, 0, ""
        try:
            while not self.parar and leidos < 16000 * 2 * self.segundos:
                d = proc.stdout.read(3200)
                if not d:
                    break
                leidos += len(d)
                muestras = memoryview(d).cast("h")
                rms = math.sqrt(sum(x * x for x in muestras[::8]) / max(1, len(muestras[::8]))) / 32768
                self.nivel.emit(min(1.0, rms * 6))
                fin, texto = o.oir(d)
                if texto and texto != ultimo:
                    ultimo = texto; habla = True; silencio = 0; self.parcial.emit(texto)
                elif habla:
                    silencio += 1
                if fin and texto:
                    self.listo.emit(texto); return
                if habla and silencio > 12:  # 1,2 s de silencio después de hablar
                    break
            self.listo.emit(o.final() or ultimo)
        finally:
            proc.terminate()


class Burbuja(QWidget):
    def __init__(self, escuchar=True):
        super().__init__()
        self.conf = leer_conf()
        self.setWindowTitle("Luna")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setFixedWidth(760)
        self.pendiente = None
        self.hilo = None
        self.oreja = None
        self.voz = None

        caja = QHBoxLayout(self); caja.setContentsMargins(26, 22, 22, 22); caja.setSpacing(18)
        self.orbe = Orbe(150); caja.addWidget(self.orbe, 0, Qt.AlignmentFlag.AlignTop)
        col = QVBoxLayout(); col.setSpacing(8); caja.addLayout(col, 1)
        arriba = QHBoxLayout()
        self.estado = QLabel("LUNA"); self.estado.setObjectName("estado")
        arriba.addWidget(self.estado); arriba.addStretch(1)
        for txt, tip, fn in (("🎙", "Volver a escuchar", self.escuchar), ("⚙", "Configurar a Luna", self.ajustes),
                             ("✕", "Cerrar (Esc)", self.close)):
            b = QPushButton(txt); b.setObjectName("icono"); b.setToolTip(tip); b.clicked.connect(fn); arriba.addWidget(b)
        col.addLayout(arriba)
        self.dicho = QLabel(""); self.dicho.setObjectName("dicho"); self.dicho.setWordWrap(True); self.dicho.hide()
        self.resp = QLabel(""); self.resp.setObjectName("respuesta"); self.resp.setWordWrap(True)
        col.addWidget(self.dicho); col.addWidget(self.resp)
        self.extra = QVBoxLayout(); col.addLayout(self.extra)
        self.chips = QHBoxLayout(); self.chips.setSpacing(6); col.addLayout(self.chips)
        for s in ("abre Steam", "sube el volumen", "¿cuánta RAM uso?", "ayuda"):
            b = QPushButton(s); b.setObjectName("chip"); b.clicked.connect(lambda _=False, s=s: self.procesar(s))
            self.chips.addWidget(b)
        self.chips.addStretch(1)
        self.entrada = QLineEdit(); self.entrada.setPlaceholderText("Escríbele a Luna…  (por ejemplo: abre Spotify)")
        self.entrada.returnPressed.connect(lambda: self.procesar(self.entrada.text()))
        col.addWidget(self.entrada)

        self.cerrar_luego = QTimer(self); self.cerrar_luego.setSingleShot(True); self.cerrar_luego.timeout.connect(self.close)
        if not self.conf.get("activa", True):
            self.decir("Estoy desactivada. Puedes activarme en mis ajustes (botón ⚙).", hablar_tambien=False)
        elif escuchar and puede_escuchar():
            QTimer.singleShot(250, self.escuchar)
        else:
            self.decir("¡Hola! ¿En qué te ayudo?" + ("" if puede_escuchar() else " Escríbeme abajo."), hablar_tambien=False)
            self.entrada.setFocus()

    def paintEvent(self, _):
        p = QPainter(self); p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(4, 4, -4, -4)
        path = QPainterPath(); path.addRoundedRect(r, 30, 30)
        g = QRadialGradient(QPointF(r.left() + 100, r.top() + 90), r.width())
        g.setColorAt(0, QColor(46, 38, 110, 245)); g.setColorAt(1, QColor(14, 12, 36, 245))
        p.fillPath(path, g)
        p.setPen(QPen(QColor(169, 150, 255, 120), 1.5)); p.drawPath(path)

    def keyPressEvent(self, e):
        if e.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(e)

    def enterEvent(self, _):
        self.cerrar_luego.stop()

    def closeEvent(self, e):
        if self.hilo and self.oreja:
            self.oreja.parar = True
        super().closeEvent(e)

    # --- escuchar ---
    def escuchar(self):
        if not puede_escuchar():
            self.decir("No tengo micrófono o reconocimiento de voz aquí. Escríbeme abajo.", hablar_tambien=False)
            return
        if self.hilo and self.hilo.isRunning():
            return
        self.cerrar_luego.stop(); self._limpiar_extra()
        self.orbe.estado = "escuchando"; self.estado.setText("TE ESCUCHO…")
        self.dicho.hide(); self.resp.setText("Habla ahora…")
        self.hilo = QThread(self); self.oreja = Oreja()
        self.oreja.moveToThread(self.hilo)
        self.hilo.started.connect(self.oreja.correr)
        self.oreja.nivel.connect(lambda n: setattr(self.orbe, "nivel", max(self.orbe.nivel, n)))
        self.oreja.parcial.connect(lambda t: (self.dicho.setText(f"«{t}»"), self.dicho.show()))
        self.oreja.listo.connect(self._oido)
        self.oreja.error.connect(lambda m: self.decir(m + " Escríbeme abajo.", hablar_tambien=False))
        self.oreja.listo.connect(self.hilo.quit); self.oreja.error.connect(self.hilo.quit)
        self.hilo.start()

    def showEvent(self, e):
        super().showEvent(e)
        QTimer.singleShot(0, self._ajustar)

    def _oido(self, texto):
        if not texto.strip():
            self.orbe.estado = "quieta"; self.estado.setText("LUNA")
            self.resp.setText("No te escuché bien. Toca 🎙 para intentarlo otra vez, o escríbeme.")
            self.entrada.setFocus(); return
        self.procesar(texto)

    # --- entender y responder ---
    def procesar(self, texto):
        texto = texto.strip()
        if not texto:
            return
        self.entrada.clear(); self._limpiar_extra()
        self.dicho.setText(f"«{texto}»"); self.dicho.show()
        self.orbe.estado = "pensando"; self.estado.setText("PENSANDO…")
        QTimer.singleShot(350, lambda: self._responder(entender(texto)))

    def _responder(self, a):
        self.decir(a["respuesta"])
        if a.get("confirmar"):
            fila = QHBoxLayout()
            si = QPushButton(a["confirmar"]); si.setObjectName("principal")
            no = QPushButton("Cancelar")
            si.clicked.connect(lambda: (ejecutar(a), self.close())); no.clicked.connect(self.close)
            fila.addWidget(si); fila.addWidget(no); fila.addStretch(1)
            w = QWidget(); w.setLayout(fila); self.extra.addWidget(w)
            QTimer.singleShot(0, self._ajustar)
            return
        if a.get("ayuda"):
            g = QGridLayout(); g.setHorizontalSpacing(14); g.setVerticalSpacing(4)
            for i, (grupo, frases) in enumerate(AYUDA.items()):
                tl = QLabel(grupo); tl.setObjectName("estado"); g.addWidget(tl, (i // 2) * 2, i % 2)
                fl = QLabel("\n".join("• " + f for f in frases[:4])); fl.setObjectName("muted")
                g.addWidget(fl, (i // 2) * 2 + 1, i % 2)
            w = QWidget(); w.setLayout(g); self.extra.addWidget(w)
            QTimer.singleShot(0, self._ajustar)
            return
        if any(a.get(k) for k in ("run", "abrir", "term")):
            ejecutar(a)
            self.cerrar_luego.start(5000)

    def decir(self, texto, hablar_tambien=True):
        self.resp.setText(texto)
        QTimer.singleShot(0, self._ajustar)
        self.estado.setText("LUNA")
        if hablar_tambien and self.conf.get("voz") != "ninguna":
            self.orbe.estado = "hablando"
            self.voz = hablar(texto, self.conf)
            QTimer.singleShot(400 + 70 * len(texto), lambda: setattr(self.orbe, "estado", "quieta"))
        else:
            self.orbe.estado = "quieta"

    def _ajustar(self):
        """La burbuja crece o se achica según lo que tenga adentro."""
        lay = self.layout(); lay.activate()
        h = lay.totalHeightForWidth(self.width()) if lay.hasHeightForWidth() else lay.sizeHint().height()
        self.resize(self.width(), max(h, 200))

    def _limpiar_extra(self):
        while self.extra.count():
            it = self.extra.takeAt(0)
            if it.widget():
                it.widget().deleteLater()

    def ajustes(self):
        subprocess.Popen([sys.argv[0], "--ajustes"], start_new_session=True)
        self.close()


def tarjeta(titulo, texto=""):
    f = QFrame(); f.setObjectName("card")
    v = QVBoxLayout(f); v.setContentsMargins(20, 16, 20, 18); v.setSpacing(10)
    t = QLabel(titulo); t.setObjectName("h2"); v.addWidget(t)
    if texto:
        d = QLabel(texto); d.setObjectName("muted"); d.setWordWrap(True); v.addWidget(d)
    return f, v


class PanelVoz(QWidget):
    """Elegir voz, velocidad y probarla (se usa en Ajustes y en la presentación)."""
    def __init__(self, conf, al_cambiar):
        super().__init__()
        self.conf, self.al_cambiar = conf, al_cambiar
        v = QVBoxLayout(self); v.setContentsMargins(0, 0, 0, 0); v.setSpacing(8)
        g = QButtonGroup(self)
        hay = voces_disponibles()
        opciones = [(k, f"{VOCES[k][1]} ({VOCES[k][2]})") for k in VOCES if k in hay]
        if not opciones and shutil.which("espeak-ng"):
            opciones = [("daniela", "Voz básica")]
        opciones.append(("ninguna", "Sin voz: Luna solo escribe"))
        for clave, txt in opciones:
            rb = QRadioButton(txt); g.addButton(rb); v.addWidget(rb)
            rb.setChecked(conf.get("voz") == clave)
            rb.toggled.connect(lambda on, clave=clave: on and self._cambia("voz", clave))
        if not any(b.isChecked() for b in g.buttons()):
            g.buttons()[0].setChecked(True)
        fila = QHBoxLayout()
        fila.addWidget(QLabel("🐢"))
        sl = QSlider(Qt.Orientation.Horizontal); sl.setRange(70, 140); sl.setValue(int(conf.get("velocidad", 1.0) * 100))
        sl.valueChanged.connect(lambda n: self._cambia("velocidad", n / 100)); fila.addWidget(sl, 1)
        fila.addWidget(QLabel("🐇"))
        prueba = QPushButton("▶  Probar voz"); prueba.clicked.connect(
            lambda: hablar("Hola, soy Luna. ¿En qué te ayudo hoy?", self.conf))
        fila.addSpacing(10); fila.addWidget(prueba)
        v.addLayout(fila)

    def _cambia(self, k, val):
        self.conf[k] = val; self.al_cambiar()


class Ajustes(QWidget):
    def __init__(self):
        super().__init__()
