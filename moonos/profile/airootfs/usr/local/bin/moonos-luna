        self.setWindowTitle("Luna · Ajustes"); self.resize(760, 820); self.setObjectName("fondo")
        if Path(ICONO).exists():
            self.setWindowIcon(QIcon(ICONO))
        fuera = QVBoxLayout(self); fuera.setContentsMargins(0, 0, 0, 0)
        sc = QScrollArea(); sc.setWidgetResizable(True); fuera.addWidget(sc)
        cont = QWidget(); cont.setObjectName("fondo"); sc.setWidget(cont)
        v = QVBoxLayout(cont); v.setContentsMargins(30, 26, 30, 30); v.setSpacing(16)

        cab = QHBoxLayout(); cab.addWidget(Orbe(110))
