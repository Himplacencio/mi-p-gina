#!/usr/bin/env python3
"""Tienda MoonOS: instala apps con un clic.

Usa Flatpak + Flathub (apps aisladas del sistema, sin contraseña de
administrador y sin riesgo de romper MoonOS). Lo que ya viene en MoonOS
(Steam, Lutris, Firefox) aparece como «Instalado».

Con MOONOS_DRY=1 no instala nada (solo para pruebas).
"""
import os
import shutil
import subprocess
import sys
from pathlib import Path

from PyQt6.QtCore import Qt, QProcess, QTimer
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (QApplication, QButtonGroup, QFrame, QGridLayout, QHBoxLayout, QLabel, QLineEdit,
                             QMainWindow, QProgressBar, QPushButton, QScrollArea, QVBoxLayout, QWidget)

DRY = os.environ.get("MOONOS_DRY") == "1"
LOGO = "/usr/share/pixmaps/moonos.png"
FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"

# (nombre, id de Flathub, comando si viene instalada en MoonOS, emoji, color, descripción)
