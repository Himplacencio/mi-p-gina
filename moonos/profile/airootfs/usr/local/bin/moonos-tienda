def flatpak_installed():
    if DRY:
        return {"com.spotify.Client"}
    try:
        out = subprocess.run(["flatpak", "list", "--app", "--columns=application"], capture_output=True, text=True, timeout=20).stdout
        return set(out.split())
    except (OSError, subprocess.SubprocessError):
        return set()


class AppCard(QFrame):
    def __init__(self, store, name, app_id, native, emoji, color, desc):
        super().__init__()
        self.store, self.name, self.app_id, self.native = store, name, app_id, native
        self.setObjectName("card")
        self.setMinimumWidth(300)
        lay = QHBoxLayout(self); lay.setContentsMargins(14, 14, 14, 14); lay.setSpacing(14)
        tile = QLabel(emoji); tile.setFixedSize(56, 56); tile.setAlignment(Qt.AlignmentFlag.AlignCenter)
        tile.setStyleSheet(f"background: {color}; border-radius: 14px; font-size: 26px;")
        lay.addWidget(tile, 0, Qt.AlignmentFlag.AlignTop)
        col = QVBoxLayout(); col.setSpacing(4)
        top = QHBoxLayout(); n = QLabel(name); n.setObjectName("appname"); top.addWidget(n)
        self.badge = QLabel(""); self.badge.setObjectName("badge"); top.addWidget(self.badge); top.addStretch(1)
        col.addLayout(top)
        d = QLabel(desc); d.setObjectName("muted"); d.setWordWrap(True); col.addWidget(d)
        self.progress = QProgressBar(); self.progress.setRange(0, 0); self.progress.setTextVisible(False); self.progress.hide()
        col.addWidget(self.progress)
        btns = QHBoxLayout(); btns.setSpacing(6)
        self.main = QPushButton(); self.main.setObjectName("install"); self.main.clicked.connect(self.on_main)
        self.remove = QPushButton("Desinstalar"); self.remove.clicked.connect(self.on_remove)
        btns.addWidget(self.main); btns.addWidget(self.remove); btns.addStretch(1)
        col.addLayout(btns)
        lay.addLayout(col, 1)
        self.refresh()

    def is_native(self):
        return bool(self.native and (DRY and self.native in ("steam", "lutris", "firefox") or shutil.which(self.native)))

    def is_installed(self):
        return self.is_native() or self.app_id in self.store.installed

    def refresh(self, busy=False):
        self.progress.setVisible(busy)
        self.main.setEnabled(not busy)
        if busy:
            return
        if self.is_native():
            self.badge.setText("✓ Incluida en MoonOS"); self.main.setText("Abrir"); self.remove.hide()
        elif self.app_id in self.store.installed:
            self.badge.setText("✓ Instalada"); self.main.setText("Abrir"); self.remove.show()
        else:
            self.badge.setText(""); self.main.setText("Instalar"); self.remove.hide()

    def on_main(self):
        if self.is_native():
            self.store.launch(self.native)
        elif self.app_id in self.store.installed:
            self.store.launch("flatpak", "run", self.app_id)
        else:
            self.store.run_flatpak(self, ["install", "--user", "-y", "--noninteractive", "flathub", self.app_id],
                                   f"Instalando {self.name}… (puede tardar unos minutos)")

    def on_remove(self):
        self.store.run_flatpak(self, ["uninstall", "--user", "-y", "--noninteractive", self.app_id], f"Desinstalando {self.name}…")


class Tienda(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Tienda MoonOS")
        if Path(LOGO).exists():
            self.setWindowIcon(QIcon(LOGO))
        self.resize(1060, 700)
        self.installed = flatpak_installed()
        self.cards = []
        self.proc = None

        root = QWidget(); root.setObjectName("root"); self.setCentralWidget(root)
        lay = QHBoxLayout(root); lay.setContentsMargins(0, 0, 0, 0); lay.setSpacing(0)
        side = QFrame(); side.setObjectName("side"); side.setFixedWidth(230)
        sl = QVBoxLayout(side); sl.setContentsMargins(14, 18, 14, 14); sl.setSpacing(4)
        b = QLabel("🛍️  Tienda"); b.setObjectName("brand"); sl.addWidget(b); sl.addSpacing(14)
        self.navs = QButtonGroup(self)
        cats = ["⭐  Todas"] + list(CATALOGO) + ["🔍  Buscar en Flathub", "💻  Comandos"]
        for i, c in enumerate(cats):
            nb = QPushButton(c); nb.setObjectName("nav"); nb.setCheckable(True)
            nb.clicked.connect(lambda _=False, c=c: self.show_category(c))
            self.navs.addButton(nb, i); sl.addWidget(nb)
        self.navs.button(0).setChecked(True)
        sl.addStretch(1)
        note = QLabel("Las apps vienen de Flathub y se instalan aisladas: no pueden dañar MoonOS.")
        note.setObjectName("muted"); note.setWordWrap(True); sl.addWidget(note)

        main = QWidget(); main.setObjectName("page"); ml = QVBoxLayout(main); ml.setContentsMargins(28, 24, 28, 16); ml.setSpacing(12)
        self.title = QLabel("Todas las apps"); self.title.setObjectName("h1")
        self.lead = QLabel("Instala lo que necesites con un clic. Sin contraseñas ni configuraciones raras.")
        self.lead.setObjectName("lead"); self.lead.setWordWrap(True)
        self.search = QLineEdit(); self.search.setPlaceholderText("Buscar apps…  (ej.: discord, spotify, chrome)")
        self.search.textChanged.connect(self.filter)
        self.search.returnPressed.connect(self.search_flathub_if_needed)
        self.status = QLabel(""); self.status.setObjectName("muted")
        ml.addWidget(self.title); ml.addWidget(self.lead); ml.addWidget(self.search); ml.addWidget(self.status)
        self.grid_host = QWidget(); self.grid_host.setObjectName("page")
        self.grid = QGridLayout(self.grid_host); self.grid.setSpacing(12); self.grid.setContentsMargins(0, 0, 0, 0)
        self.apps_scroll = QScrollArea(); self.apps_scroll.setWidgetResizable(True); self.apps_scroll.setWidget(self.grid_host)
        ml.addWidget(self.apps_scroll, 1)
        self.cmd_rows = []
        self.cmd_scroll = QScrollArea(); self.cmd_scroll.setWidgetResizable(True); self.cmd_scroll.setWidget(self.build_commands())
        self.cmd_scroll.hide()
        ml.addWidget(self.cmd_scroll, 1)
        lay.addWidget(side); lay.addWidget(main, 1)

        for cat, apps in CATALOGO.items():
            for a in apps:
                card = AppCard(self, *a); card.category = cat; self.cards.append(card)
        self.current = "⭐  Todas"
        self.layout_cards()

    # ---------- comandos ----------
    def build_commands(self):
        host = QWidget(); host.setObjectName("page")
        v = QVBoxLayout(host); v.setContentsMargins(0, 0, 8, 0); v.setSpacing(8)
        abrir = QPushButton("💻  Abrir la terminal"); abrir.setObjectName("install")
        abrir.clicked.connect(lambda: self.launch("konsole"))
        top = QHBoxLayout(); top.addWidget(abrir); top.addStretch(1); v.addLayout(top)
        tip = QLabel("Copia un comando, pégalo en la terminal con Ctrl+Shift+V y cambia «nombre» por lo que quieras. "
                     "«sudo» pide tu contraseña porque el comando cambia el sistema; al escribirla no se ven las letras, es normal.")
        tip.setObjectName("muted"); tip.setWordWrap(True); v.addWidget(tip)
        for section, cmds in COMANDOS.items():
            t = QLabel(section); t.setObjectName("section"); v.addWidget(t)
            for cmd, desc in cmds:
                row = QFrame(); row.setObjectName("card")
                h = QHBoxLayout(row); h.setContentsMargins(12, 10, 12, 10); h.setSpacing(12)
                col = QVBoxLayout(); col.setSpacing(6)
                c = QLabel(cmd); c.setObjectName("cmd"); c.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
                d = QLabel(desc); d.setObjectName("muted"); d.setWordWrap(True)
                col.addWidget(c); col.addWidget(d)
                h.addLayout(col, 1)
                b = QPushButton("Copiar"); b.clicked.connect(lambda _=False, cmd=cmd, b=b: self.copy(cmd, b))
                h.addWidget(b, 0, Qt.AlignmentFlag.AlignTop)
                v.addWidget(row)
                self.cmd_rows.append((row, (cmd + " " + desc + " " + section).lower()))
        v.addStretch(1)
        return host

    def copy(self, cmd, btn):
        QApplication.clipboard().setText(cmd)
        btn.setText("✓ Copiado")
        QTimer.singleShot(1500, lambda: btn.setText("Copiar"))

    def filter_commands(self):
        q = self.search.text().strip().lower()
        for row, text in self.cmd_rows:
            row.setVisible(not q or q in text)

    # ---------- vista ----------
    def visible_cards(self):
        q = self.search.text().strip().lower()
        out = []
        for c in self.cards:
            if self.current not in ("⭐  Todas", "🔍  Buscar en Flathub") and c.category != self.current:
                continue
            if q and q not in c.name.lower() and q not in c.app_id.lower():
                continue
            out.append(c)
        return out

    def layout_cards(self):
        while self.grid.count():
            it = self.grid.takeAt(0)
            if it.widget():
                it.widget().setParent(None)
        cards = self.visible_cards()
        for i, c in enumerate(cards):
            self.grid.addWidget(c, i // 2, i % 2)
        self.grid.setRowStretch(len(cards) // 2 + 1, 1)
        if not cards and self.search.text().strip():
            self.status.setText("No está en la lista de MoonOS. Pulsa Enter para buscarla en Flathub.")
        elif self.status.text().startswith("No está"):
            self.status.setText("")

    def show_category(self, cat):
        self.current = cat
        comandos = cat == "💻  Comandos"
        self.apps_scroll.setVisible(not comandos)
        self.cmd_scroll.setVisible(comandos)
        self.search.setPlaceholderText("Buscar comandos…  (ej.: instalar, buscar, ram, drivers)" if comandos
                                       else "Buscar apps…  (ej.: discord, spotify, chrome)")
        self.title.setText("Todas las apps" if cat == "⭐  Todas" else cat.split("  ", 1)[1])
        if comandos:
            self.lead.setText("Los comandos más usados en MoonOS, explicados. Pulsa «Copiar» y pégalo en la terminal.")
            self.filter_commands()
            return
        if cat == "🔍  Buscar en Flathub":
            self.lead.setText("Escribe el nombre de cualquier app y pulsa Enter: hay miles en Flathub.")
            self.search.setFocus()
        else:
            self.lead.setText("Instala lo que necesites con un clic. Sin contraseñas ni configuraciones raras.")
        self.layout_cards()

    def filter(self):
        if self.current == "💻  Comandos":
            self.filter_commands()
        else:
            self.layout_cards()

    # ---------- búsqueda en Flathub ----------
    def search_flathub_if_needed(self):
        q = self.search.text().strip()
        if self.current == "💻  Comandos":
            return
        if not q or (self.visible_cards() and self.current != "🔍  Buscar en Flathub"):
            return
        self.status.setText(f"Buscando «{q}» en Flathub…")
        if DRY:
            self.show_results([("Ejemplo encontrado", "org.ejemplo.App", "Resultado de prueba")])
            return
        p = QProcess(self)
        p.finished.connect(lambda *_: self.parse_search(p))
        # Asegura el catálogo de Flathub antes de buscar
        p.start("bash", ["-c", f"flatpak remote-add --user --if-not-exists flathub {FLATHUB} >/dev/null 2>&1; "
                               f"flatpak search --columns=name,application,description {self._quote(q)}"])

    @staticmethod
    def _quote(s):
        return "'" + s.replace("'", "'\\''") + "'"

    def parse_search(self, p):
        rows = []
        for line in bytes(p.readAllStandardOutput()).decode(errors="replace").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and "." in parts[1]:
                rows.append((parts[0], parts[1], parts[2] if len(parts) > 2 else ""))
        self.show_results(rows[:20])

    def show_results(self, rows):
        if not rows:
            self.status.setText("No se encontró nada. Prueba con otro nombre.")
            return
        self.status.setText(f"{len(rows)} resultados en Flathub")
        known = {c.app_id for c in self.cards}
        for name, app_id, desc in rows:
            if app_id in known:
                continue
            card = AppCard(self, name, app_id, None, "📦", "#2a2560", desc or "App de Flathub")
            card.category = "🔍  Buscar en Flathub"
            self.cards.append(card)
        self.current = "🔍  Buscar en Flathub"
        self.navs.button(len(CATALOGO) + 1).setChecked(True)
        self.search.blockSignals(True); self.search.clear(); self.search.blockSignals(False)
        self.layout_cards()

    # ---------- instalar / abrir ----------
    def launch(self, *cmd):
        print("[tienda]", " ".join(cmd), flush=True)
        if not DRY:
            QProcess.startDetached(cmd[0], list(cmd[1:]))

    def run_flatpak(self, card, args, msg):
        if self.proc is not None:
            self.status.setText("Espera a que termine la instalación en curso.")
            return
        card.refresh(busy=True)
        self.status.setText(msg)
        print("[tienda] flatpak", " ".join(args), flush=True)
        if DRY:
            QTimer.singleShot(800, lambda: self.done(card, args, 0))
            return
        self.proc = QProcess(self)
        self.proc.finished.connect(lambda code, _st: self.done(card, args, code))
        self.proc.start("bash", ["-c", f"flatpak remote-add --user --if-not-exists flathub {FLATHUB} && flatpak "
                                       + " ".join(self._quote(a) for a in args)])

    def done(self, card, args, code):
        self.proc = None
        if code == 0:
            if args[0] == "install":
                self.installed.add(card.app_id); self.status.setText(f"✓ {card.name} instalada. Ya está en el menú de aplicaciones.")
            else:
                self.installed.discard(card.app_id); self.status.setText(f"{card.name} desinstalada.")
        else:
            self.status.setText(f"No se pudo completar. ¿Tienes conexión a internet? (código {code})")
        card.refresh()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Tienda MoonOS")
    app.setDesktopFileName("moonos-tienda")
    app.setStyleSheet(STYLE)
    w = Tienda(); w.show()
    try:
        recorrido = "moonos.demo=recorrido" in Path("/proc/cmdline").read_text()
    except OSError:
        recorrido = False
    if recorrido:  # grabación de demostración: muestra los comandos y se cierra
        def comandos():
            w.navs.button(len(CATALOGO) + 2).setChecked(True); w.show_category("💻  Comandos")
        QTimer.singleShot(8000, comandos)
        QTimer.singleShot(17000, app.quit)
    if os.environ.get("MOONOS_SHOT"):
        def shot():
            w.grab().save(os.environ["MOONOS_SHOT"] + "-todas.png")
            w.show_category("🎵  Música y video"); app.processEvents()
            w.cards[[c.name for c in w.cards].index("Spotify")].refresh(busy=False)
            w.grab().save(os.environ["MOONOS_SHOT"] + "-musica.png")
            w.show_category("💻  Comandos"); app.processEvents()
            w.grab().save(os.environ["MOONOS_SHOT"] + "-comandos.png")
            app.quit()
        QTimer.singleShot(500, shot)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
