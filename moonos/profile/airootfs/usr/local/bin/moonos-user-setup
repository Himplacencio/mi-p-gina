#!/bin/bash
# Se ejecuta una sola vez por usuario al entrar a Plasma: deja el escritorio
# con el estilo de MoonOS (todo se puede cambiar luego en «Hazlo tuyo»):
#   - tema oscuro con el esquema de colores «MoonOS» (índigo y lavanda)
#   - fondo de la luna
#   - estilo «MoonOS Dock»: barra arriba (con música), dock de vidrio centrado
#     y widgets de vidrio en el escritorio
flag="${XDG_CONFIG_HOME:-$HOME/.config}/moonos-user-setup-done"
[[ -e "$flag" ]] && exit 0

# Esperar a que el escritorio (plasmashell) esté listo, máximo ~60 s
for _ in $(seq 1 60); do
    busctl --user list 2>/dev/null | grep -q '^org.kde.plasmashell ' && break
    sleep 1
done
sleep 2

plasma-apply-lookandfeel -a org.kde.breezedark.desktop >/dev/null 2>&1 || true
plasma-apply-colorscheme MoonOS >/dev/null 2>&1 || true

plasma_js() {
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$1" >/dev/null 2>&1 || true
}

# Fondo: la luna animada si se pidió en el arranque (videos de demostración); si no, la fija
if grep -q 'moonos.demo=' /proc/cmdline 2>/dev/null; then
    plasma_js "desktops().forEach(function (d) { d.wallpaperPlugin = 'org.moonos.lunaanimada'; d.currentConfigGroup = ['Wallpaper', 'org.moonos.lunaanimada', 'General']; });"
else
    plasma-apply-wallpaperimage /usr/share/wallpapers/MoonOS/contents/images/1920x1080.png >/dev/null 2>&1 || true
fi

# Estilo de inicio por defecto: MoonOS Dock (en «Hazlo tuyo» se puede volver al clásico)
if [[ -f /usr/share/moonos/estilos/dock.js ]]; then
    plasma_js "$(cat /usr/share/moonos/estilos/dock.js)"
fi

mkdir -p "$(dirname "$flag")"
touch "$flag"
